        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>A list of the diagnostic requests that resulted in this imaging study being performed.</rdfs:comment>
        <rdfs:label>basedOn</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


