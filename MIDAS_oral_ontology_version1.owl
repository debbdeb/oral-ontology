        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>A participant who has attested to the accuracy of the composition/document.</rdfs:comment>
        <rdfs:label>attester</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


