        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Who attested the composition in the specified way.</rdfs:comment>
        <rdfs:label>party</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-InvoiceRecord-definitions.html#diff_Composition.author -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-InvoiceRecord-definitions.html#diff_Composition.author">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-InvoiceRecord-definitions.html#diff_Composition"/>
