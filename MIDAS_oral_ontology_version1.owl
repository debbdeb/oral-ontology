        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>The base language in which the resource is written.</rdfs:comment>
        <rdfs:label>language</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.locationCode -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.locationCode">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>The preferred location(s) where the procedure should actually happen in coded or free text form. E.g. at home or nursing day care center.</rdfs:comment>
        <rdfs:label>locationCode</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.locationReference -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.locationReference">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>A reference to the the preferred location(s) where the procedure should actually happen. E.g. at home or nursing day care center.</rdfs:comment>
        <rdfs:label>locationReference</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.meta -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.meta">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>The metadata about the resource. This is content that is maintained by the infrastructure. Changes to the content might not always be associated with version changes to the resource.</rdfs:comment>
        <rdfs:label>meta</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.modifierExtension -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.modifierExtension">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>May be used to represent additional information that is not part of the basic definition of the resource and that modifies the understanding of the element that contains it and/or the understanding of the containing element&apos;s descendants. Usually modifier elements provide negation or qualification. To make the use of extensions safe and manageable, there is a strict set of governance applied to the definition and use of extensions. Though any implementer is allowed to define an extension, there is a set of requirements that SHALL be met as part of the definition of the extension. Applications processing a resource are required to check for modifier extensions.

Modifier extensions SHALL NOT change the meaning of any elements on Resource or DomainResource (including cannot change the meaning of modifierExtension itself).</rdfs:comment>
        <rdfs:label>modifierExtension</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.note -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.note">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>Any other notes and comments made about the service request. For example, internal billing notes.</rdfs:comment>
        <rdfs:label>note</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.orderDetail -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.orderDetail">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>Additional details and instructions about the how the services are to be delivered.   For example, and order for a urinary catheter may have an order detail for an external or indwelling catheter, or an order for a bandage may require additional instructions specifying how the bandage should be applied.</rdfs:comment>
        <rdfs:label>orderDetail</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.patientInstruction -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.patientInstruction">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Instructions in terms that are understood by the patient or consumer.</rdfs:comment>
        <rdfs:label>patientInstruction</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.performer -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.performer">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>The desired performer for doing the requested service.  For example, the surgeon, dermatopathologist, endoscopist, etc.</rdfs:comment>
        <rdfs:label>performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.performerType -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.performerType">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Desired type of performer for doing the requested service.</rdfs:comment>
        <rdfs:label>performerType</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.priority -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.priority">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Indicates how quickly the ServiceRequest should be addressed with respect to other requests.</rdfs:comment>
        <rdfs:label>priority</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.reasonCode -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.reasonCode">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>An explanation or justification for why this service is being requested in coded or textual form.   This is often for billing purposes.  May relate to the resources referred to in `supportingInfo`.</rdfs:comment>
        <rdfs:label>reasonCode</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.reasonReference -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.reasonReference">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>Indicates another resource that provides a justification for why this service is being requested.   May relate to the resources referred to in `supportingInfo`.</rdfs:comment>
        <rdfs:label>reasonReference</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.relevantHistory -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.relevantHistory">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>Key events in the history of the request.</rdfs:comment>
        <rdfs:label>relevantHistory</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.replaces -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.replaces">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>The request takes the place of the referenced completed or terminated request(s).</rdfs:comment>
        <rdfs:label>replaces</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.requester -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.requester">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>1...1</ns1:mandatoryOrNot>
        <rdfs:comment>The individual who initiated the request and has responsibility for its activation.</rdfs:comment>
        <rdfs:label>requester</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/1...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.requisition -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.requisition">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>A shared identifier common to all service requests that were authorized more or less simultaneously by a single author, representing the composite or group identifier.</rdfs:comment>
        <rdfs:label>requisition</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.specimen -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.specimen">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>One or more specimens that the laboratory procedure will use.</rdfs:comment>
        <rdfs:label>specimen</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.status -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.status">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>1...1</ns1:mandatoryOrNot>
        <rdfs:comment>The status of the order.</rdfs:comment>
        <rdfs:label>status</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/1...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.subject -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.subject">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>1...1</ns1:mandatoryOrNot>
        <rdfs:comment>On whom or what the service is to be performed. This is usually a human patient, but can also be requested on animals, groups of humans or animals, devices such as dialysis machines, or even locations (typically for environmental scans).</rdfs:comment>
        <rdfs:label>subject</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/1...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.supportingInfo -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.supportingInfo">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>Additional clinical information about the patient or specimen that may influence the services or their interpretations.     This information includes diagnosis, clinical findings and other observations.  In laboratory ordering these are typically referred to as &quot;ask at order entry questions (AOEs)&quot;.  This includes observations explicitly requested by the producer (filler) to provide context or supporting information needed to complete the order. For example,  reporting the amount of inspired oxygen for blood gas measurements.</rdfs:comment>
        <rdfs:label>supportingInfo</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.text -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.text">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>A human-readable narrative that contains a summary of the resource and can be used to represent the content of the resource to a human. The narrative need not encode all the structured data, but is required to contain sufficient detail to make it &quot;clinically safe&quot; for a human to just read the narrative. Resource definitions may define what content should be represented in the narrative to ensure clinical safety.</rdfs:comment>
        <rdfs:label>text</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.asNeeded[x] -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.asNeeded[x]">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>If a CodeableConcept is present, it indicates the pre-condition for performing the service.  For example &quot;pain&quot;, &quot;on flare-up&quot;, etc.</rdfs:comment>
        <rdfs:label>asNeeded[x]</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.occurrence[x] -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.occurrence[x]">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>The date/time at which the requested service should occur.</rdfs:comment>
        <rdfs:label>occurrence[x]</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.quantity[x] -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest.quantity[x]">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-ServiceRequest-definitions.html#ServiceRequest"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>An amount of service being requested which can be a quantity ( for example $1,500 home modification), a ratio ( for example, 20 half day visits per month), or a range (2.0 to 1.8 Gy per fraction).</rdfs:comment>
        <rdfs:label>quantity[x]</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/profiles.html"/>
        <ns1:mandatoryOrNot>0...*</ns1:mandatoryOrNot>
        <rdfs:comment>A sample to be used for analysis.</rdfs:comment>
        <rdfs:comment>This profile sets minimum expectations for the Specimen resource to searching for and fetching information regarding a sample to be used for the analysis of a patient.</rdfs:comment>
        <rdfs:label>Specimen</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...*"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.accessionIdentifier -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.accessionIdentifier">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>The identifier assigned by the lab when accessioning specimen(s). This is not necessarily the same as the specimen identifier, depending on local lab procedures.</rdfs:comment>
        <rdfs:label>accessionIdentifier</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Details concerning the specimen collection.</rdfs:comment>
        <rdfs:label>collection</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection.bodySite -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection.bodySite">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Anatomical location from which the specimen was collected (if subject is a patient). This is the target site.  This element is not used for environmental specimens.</rdfs:comment>
        <rdfs:label>bodySite</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection.collector -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection.collector">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>Person who collected the specimen.</rdfs:comment>
        <rdfs:label>collector</rdfs:label>
        <rdfs:seeAlso rdf:resource="file:///content/sample_data/myfiles/MyDrive/0...1"/>
    </owl:Class>
    


    <!-- https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection.duration -->

    <owl:Class rdf:about="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection.duration">
        <rdfs:subClassOf rdf:resource="https://www.nrces.in/ndhm/fhir/r4/StructureDefinition-Specimen-definitions.html#Specimen.collection"/>
        <ns1:mandatoryOrNot>0...1</ns1:mandatoryOrNot>
        <rdfs:comment>The span of time over which the collection of a specimen occurred.</rdfs:comment>
        <rdfs:label>duration</rdfs:label>
