    </owl:AnnotationProperty>
    


    <!-- http://example.com/exacerbates -->

    <owl:AnnotationProperty rdf:about="http://example.com/exacerbates">
        <rdfs:comment>The act of something worsens the confirmation of a disease diagnosis, indicating its detrimental impact on the severity or progression of the disease.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/hasPart -->

    <owl:AnnotationProperty rdf:about="http://example.com/hasPart">
        <rdfs:comment></rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/hasPossibleCausativeAgent -->

    <owl:AnnotationProperty rdf:about="http://example.com/hasPossibleCausativeAgent">
        <rdfs:comment>Presence of a potential causative factor or agent that could contribute to the development or occurrence of a specific condition or event.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/hasRelatedCondition -->

    <owl:AnnotationProperty rdf:about="http://example.com/hasRelatedCondition">
        <rdfs:comment>Refers to the definitive identification and acknowledgment of the presence of oral cancer through clinical, imaging, or pathological examinations.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/isAdjascentTo -->

    <owl:AnnotationProperty rdf:about="http://example.com/isAdjascentTo">
        <rdfs:comment>Indicates a spatial proximity.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/isContainedIn -->

    <owl:AnnotationProperty rdf:about="http://example.com/isContainedIn">
        <rdfs:comment>A potential connection.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/isPartOf -->

    <owl:AnnotationProperty rdf:about="http://example.com/isPartOf">
        <rdfs:comment></rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://example.com/mandatoryOrNot -->

